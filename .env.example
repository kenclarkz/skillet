# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute base URL of the deployed app. Used for invite + QR links.
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Walmart (optional) — live product search + cart via Walmart APIs
# Leave unset to fall back to honest search links (never a fake cart).
# ---------------------------------------------------------------------------
# WALMART_CONSUMER_ID=
# WALMART_PRIVATE_KEY=
# WALMART_ACCESS_TOKEN=
# WALMART_API_BASE=https://developer.api.walmart.com/api-proxy/service/affil/product/v2
# WALMART_CART_ENDPOINT=

# ---------------------------------------------------------------------------
# Instacart (optional) — live product search + cart via Instacart Connect
# Leave unset to fall back to honest search links (never a fake cart).
# ---------------------------------------------------------------------------
# INSTACART_API_KEY=
# INSTACART_API_BASE=https://connect.instacart.com
# INSTACART_SEARCH_PATH=/v1/products/search
# INSTACART_CART_PATH=/v1/carts
