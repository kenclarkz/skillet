# Copy to .env and fill in. Never commit .env to git.

# Required: long random string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional: absolute path to the SQLite database file.
# Default: <project>/instance/skillet.db (persists on PythonAnywhere)
# DATABASE_PATH=/home/yourusername/skillet-flask/instance/skillet.db

# Optional: directory for uploaded recipe photos (must be writable).
# Default: <project>/app/uploads
# UPLOAD_FOLDER=/home/yourusername/skillet-flask/app/uploads

# Optional: max upload size in bytes (default 5 MiB)
# MAX_CONTENT_LENGTH=5242880

# Optional: password hashing method (default pbkdf2:sha256:600000)
# PASSWORD_HASH_METHOD=pbkdf2:sha256:600000
