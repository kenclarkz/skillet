# Supabase project (required) — same project the Next.js app uses
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Public base URL for invite links and QR codes
APP_URL=https://yourusername.pythonanywhere.com

# Flask session signing (any long random string)
SECRET_KEY=change-me-to-something-random

# Walmart (optional — enables live product search)
# WALMART_CONSUMER_ID=
# WALMART_PRIVATE_KEY=
# WALMART_ACCESS_TOKEN=
# WALMART_API_BASE=https://developer.api.walmart.com
# WALMART_CART_ENDPOINT=

# Instacart (optional — enables live partner search/cart)
# INSTACART_API_KEY=
# INSTACART_API_BASE=https://api.instacart.com/v2
# INSTACART_SEARCH_PATH=/products
# INSTACART_CART_PATH=/carts
