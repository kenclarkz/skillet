# Database — SQLite file path (optional; sensible defaults are built in).
#
# Local development default:  python/instance/skillet.db
# PythonAnywhere default:     ~/skillet-data/skillet.db  (persistent, outside the code dir)
#
# Either a filesystem path or a sqlite:/// URI:
# DATABASE_URL=/home/yourusername/skillet-data/skillet.db
# DATABASE_URL=sqlite:////home/yourusername/skillet-data/skillet.db
# DATABASE_URL=sqlite:///./local.db

# Override the data directory (database + uploaded photos) if you like:
# SKILLET_DATA_DIR=/home/yourusername/skillet-data

# Public base URL for invite links and QR codes
APP_URL=https://yourusername.pythonanywhere.com

# Flask session signing (any long random string)
SECRET_KEY=change-me-to-something-random

# Walmart (optional — enables live product search)
# WALMART_CONSUMER_ID=
# WALMART_PRIVATE_KEY=
# WALMART_ACCESS_TOKEN=
# WALMART_API_BASE=https://developer.api.walmart.com
# WALMART_CART_ENDPOINT=

# Instacart (optional — enables live partner search/cart)
# INSTACART_API_KEY=
# INSTACART_API_BASE=https://api.instacart.com/v2
# INSTACART_SEARCH_PATH=/products
# INSTACART_CART_PATH=/carts
